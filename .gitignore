# Virtual environments
venv/
ENV/
env/
.venv/

# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
media/
# Ignore collected static files (optional - remove if you track these)
staticfiles/

# Migrations: ignore all migration files except __init__.py so apps keep migrations
campusconnect/core/migrations/*
!campusconnect/core/migrations/__init__.py

# IDEs and editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Environment variables
.env
.env.*

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml

# Packaging
build/
dist/
*.egg-info/
pip-wheel-metadata/

# OS files
Thumbs.db
desktop.ini
.DS_Store

# Misc
.mypy_cache/
.ropeproject
